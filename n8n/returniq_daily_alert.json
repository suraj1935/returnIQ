{
  "name": "ReturnIQ daily high-risk alert",
  "nodes": [
    {
      "parameters": {},
      "id": "a1f0c1d2-0001-4a00-9000-000000000001",
      "name": "Run now (for demo)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "a1f0c1d2-0002-4a00-9000-000000000002",
      "name": "Every day at 9 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/copilot/ask",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"question\": \"Which orders are likely to be returned?\"}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a1f0c1d2-0003-4a00-9000-000000000003",
      "name": "Ask ReturnIQ Copilot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0a1b2c3-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.grounded }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c1d2-0004-4a00-9000-000000000004",
      "name": "Answer verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "PASTE_YOUR_CHAT_ID",
        "text": "={{ ['ReturnIQ daily high-risk orders', '', $json.answer, '', 'Source: ' + $json.citations.map(c => c.tool + ' as of ' + c.data_as_of).join(', '), 'Engine: ' + $json.engine].join(String.fromCharCode(10)) }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c1d2-0005-4a00-9000-000000000005",
      "name": "Send alert to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "PASTE_YOUR_CHAT_ID",
        "text": "ReturnIQ could not verify today's high-risk figures, so no list was sent. Check the app before acting.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c1d2-0006-4a00-9000-000000000006",
      "name": "Send 'not verified' note",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        400
      ]
    }
  ],
  "connections": {
    "Run now (for demo)": {
      "main": [
        [
          {
            "node": "Ask ReturnIQ Copilot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every day at 9 AM": {
      "main": [
        [
          {
            "node": "Ask ReturnIQ Copilot",
