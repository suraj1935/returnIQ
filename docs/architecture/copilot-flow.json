  "cards": [
    {
      "dot": "cyan",
      "title": "Data Window",
      "items": [
        "_system_prompt reads the data window and tells the model to resolve relative dates against the snapshot.",
        "The date range is source evidence for temporal answers, not today's date."
      ]
    },
    {
      "dot": "emerald",
      "title": "Fixed Tool Surface",
      "items": [
        "The model can only request named tool schemas.",
        "call_tool rejects unknown tool names.",
        "Each tool returns query_id, params, rows and data_as_of."
      ]
    },
    {
      "dot": "rose",
      "title": "Refusal Paths",
      "items": [
        "LLM errors, missing tool calls or unusable numeric replies fall back to rules.",
        "Forecast questions are refused by rules.",
        "verify_grounding withholds answers whose figures cannot be matched to tool results."
      ]
    }
  ]
