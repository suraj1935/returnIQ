  "cards": [
    {
      "dot": "cyan",
      "title": "SQLite Tables",
      "items": [
        "raw_orders and raw_returns are created by ingestion.",
        "quarantine_ingestion stores rejected input rows.",
        "analytics_order_features, analytics_returns_fact, analytics_meta and analytics_risk_scores are refreshed by later scripts."
      ]
    },
    {
      "dot": "emerald",
      "title": "Batch And Serving Meet Only At Storage",
      "items": [
        "Batch scripts write SQLite analytics tables and models/ artifacts.",
        "Serving reads those stores through the read-only engine and fixed tools.",
        "There is no queue, cache, container runtime or load balancer in this repository slice."
      ]
    },
    {
      "dot": "rose",
      "title": "Copilot Runtime",
      "items": [
        "An LLM is used when configured through RETURNIQ_LLM or provider credentials.",
        "Ollama-compatible calls use RETURNIQ_OLLAMA_MODEL with gemma4:31b as the code default.",
        "Rules are the default without an enabled LLM and the fallback when LLM output is unusable."
      ]
    }
  ]
}
