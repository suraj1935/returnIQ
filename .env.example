# Copy to .env (git-ignored). Real environment variables take precedence over this file.
RETURNIQ_LLM=ollama                       # ollama | nvidia | anthropic | gemini | rules
RETURNIQ_ENV=dev

# Ollama Cloud (OpenAI-compatible). For a local server use http://localhost:11434/v1 and no key.
OLLAMA_URL=https://ollama.com/v1
OLLAMA_API_KEY=
RETURNIQ_OLLAMA_MODEL=gemma4:31b          # also available: gpt-oss:120b, gpt-oss:20b, nemotron-3-*
RETURNIQ_OLLAMA_FALLBACKS=                # empty: the rules engine is the fallback
RETURNIQ_LLM_TIMEOUT=90

# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# DATABASE_URL=postgresql://user:pass@host:5432/returniq
# DATABASE_URL_READONLY=postgresql://readonly_user:pass@host:5432/returniq
